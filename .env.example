# LLM mentors are optional and interchangeable (local Ollama / cloud / none).
# ── Ariaska .env Template ────────────────────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

# ── Target Configuration ─────────────────────────────────────────────
ARIASKA_TARGET_IP=10.10.10.10
ARIASKA_LIVE_MODE=0
ARIASKA_DRY_RUN=0

# ── Sudo (Local OPS Only) ────────────────────────────────────────────
# Used for: apt install, /etc/hosts management, creating directories.
# NEVER sent to LLM. NEVER logged. NEVER exposed in output.
SUDO_PASSWORD=

# ── Metasploit RPC ───────────────────────────────────────────────────
METASPLOIT_RPC_PORT=55553
METASPLOIT_RPC_USER=msf
METASPLOIT_RPC_PASS=
RESTART_METASPLOIT_RPC=0

# ── Feature Flag Overrides (prefix FF_) ──────────────────────────────
# FF_ALLOW_SUDO=1
# FF_ALLOW_LIVE_INSTALL=1
# FF_OPS_PREFLIGHT=1
# FF_EXECUTION_CLASSIFIER=1
# FF_STRICT_EXPLOIT_GATE=enforce
# FF_STRICT_PHASE_LADDER=1
# FF_USE_MICRO_CHAIN=1
# FF_PARSER_MODE=intelligent_fullparse

# ── MicroChain Tuning ────────────────────────────────────────────────
# MC_ESCALATE_THRESHOLD=0.40
# MC_NANO_ABLATION=0

# ── Mentor backend (Mentor2Apprentice) ──────────────────────────────
# The five agents run on their own RL policies. An LLM is only an OPTIONAL,
# interchangeable MENTOR. Select which one serves this process:
#   auto   (default) local if a local server is up, else cloud if configured, else none
#   none   mentor-free pure RL (reported baseline: PPO solved MS1/MS2 here)
#   local  only a local server (Ollama / llama-cpp / vLLM)
#   cloud  only a hosted API (Anthropic or OpenAI-compatible)
#   hybrid local for fast System 1/2 tasks, cloud for System 3 (strategic/postmortem)
# ARIASKA_MENTOR_BACKEND=auto
# ARIASKA_CLOUD_PROVIDER=auto        # auto | anthropic | openai-compatible
# ARIASKA_HYBRID_FAST_PATH=1         # hybrid: keep CPU-friendly single-call paths

# ── Optional cloud mentor: Anthropic (pip install anthropic) ────────
# Never commit real keys. Loaded from .env (git-ignored) or the shell.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=            # required for user-scoped sk-ant-usr-* keys
# ARIASKA_ANTHROPIC_MODEL=claude-opus-5-5
# ARIASKA_ANTHROPIC_EFFORT=medium    # low | medium | high | xhigh | max
# ARIASKA_ANTHROPIC_FALLBACKS=1      # server-side refusal fallbacks
# ARIASKA_ANTHROPIC_TIMEOUT=60

# ── Optional cloud mentor: OpenAI-compatible endpoints ──────────────
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# ARIASKA_CLOUD_API_KEY=  ARIASKA_CLOUD_BASE_URL=  ARIASKA_CLOUD_MODEL=

# ── Phase 43: Local GPU LLM ─────────────────────────────────────────
# Enable local LLM acceleration (auto-detected if model found)
# FF_LOCAL_LLM=1
# FF_LOCAL_LLM_OFFLOAD_NANO=1
# FF_LOCAL_LLM_OFFLOAD_MINI=1
# ARIASKA_FAST_MODEL=ariaska-cybersec4
# ARIASKA_MEDIUM_MODEL=ariaska-cybersec4
# ARIASKA_REASONING_MODEL=ariaska-cybersec4

# Path to local GGUF/AWQ/GPTQ model file
# ARIASKA_LOCAL_MODEL_PATH=/models/Qwen3-32B-Instruct-Q4_K_M.gguf

# Local LLM server settings
# ARIASKA_LOCAL_LLM_HOST=127.0.0.1
# ARIASKA_LOCAL_LLM_PORT=8192
# ARIASKA_LOCAL_BACKEND=llama-cpp   # llama-cpp or vllm

# GPU sync target (for scripts/gpu_sync.sh)
# ARIASKA_GPU_HOST=194.228.55.129
# ARIASKA_GPU_PORT=37127

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO

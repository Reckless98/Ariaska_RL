# ARIASKA_RL Configuration Example
# Rename this file to .env and fill in appropriate values

# OpenAI API Configuration
OPENAI_API_KEY="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"
PRIMARY_MODEL="gpt-4o-mini"  # Primary GPT model
FALLBACK_MODEL="gpt-4o-mini"  # Fallback model if primary fails
EMBEDDING_MODEL="gpt-4.1-nano"  # Model for embeddings

# Environment Configuration 
ARIASKA_MODE="simulated"  # simulated or live
ARIASKA_TARGET_IP="10.10.10.10"  # Target IP for live mode
ARIASKA_PORT_RANGE="1-1024"  # Port range to scan in live mode

# Agent Configuration
RED_AGENT_EPSILON=1.0  # Initial exploration rate
BLUE_AGENT_EPSILON=1.0  # Initial exploration rate
ORION_STRATEGY="balanced"  # balanced, aggressive, stealthy

# Training Configuration
BATCH_SIZE=64
LEARNING_RATE=0.0001
GAMMA=0.99
REPLAY_BUFFER_SIZE=10000
EPISODES=100
MAX_STEPS=50

# UI Configuration
VERBOSITY="standard"  # quiet, standard, verbose, detailed
USE_STREAMLIT_UI=false  # Enable Streamlit UI (experimental)

# Database Configuration
USE_SQLITE_MEMORY=true
CHROMADB_PATH="./core/memories/vectorstore"

# Security Settings
TOKEN_LIMIT_PER_EPISODE=5000  # Max tokens per episode
LLM_OUTPUT_SANITIZE=true  # Sanitize LLM outputs

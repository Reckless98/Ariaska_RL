# ARIASKA_RL Environment Configuration
# Copy this file to .env and adjust settings as needed

# === OpenAI API Configuration ===
OPENAI_API_KEY=sk-your-openai-key
# AZURE_OPENAI_API_KEY=your-azure-key  # Uncomment to use Azure OpenAI

# === GPT Model Selection ===
# Primary model for complex reasoning tasks
GPT_PRIMARY_MODEL=gpt-4o-mini

# Fallback model for when primary is unavailable or token limit exceeded
GPT_FALLBACK_MODEL=gpt-4.1-nano

# Lightweight model for embeddings and simple tasks
GPT_EMBEDDING_MODEL=gpt-4.1-nano

# === Token Management ===
# Maximum tokens to use per episode (0 for unlimited)
GPT_TOKEN_LIMIT=8000

# Size of the GPT response cache
GPT_CACHE_SIZE=5000

# === Environment Configuration ===
# Mode: 'simulated' or 'live'
ENVIRONMENT_MODE=simulated

# Difficulty level (1-5)
DIFFICULTY_LEVEL=1

# === Agent Configuration ===
# Default exploration parameter (0-1)
EPSILON=0.7

# Minimum exploration parameter
EPSILON_MIN=0.05

# Exploration decay rate
EPSILON_DECAY=0.994

# === Training Parameters ===
# Maximum episodes to run
MAX_EPISODES=100

# Maximum steps per episode
MAX_STEPS=50

# Replay buffer capacity
REPLAY_BUFFER_SIZE=2000

# === System Configuration ===
# CUDA device to use (-1 for CPU)
CUDA_VISIBLE_DEVICES=0

# Logging verbosity: quiet, standard, verbose, detailed
VERBOSITY=standard

# === Monitoring Configuration ===
# Grafana admin password
GRAFANA_PASSWORD=admin

# === ChromaDB Configuration ===
CHROMA_API_IMPL=rest
CHROMA_SERVER_HOST=chromadb
CHROMA_SERVER_HTTP_PORT=8000

# Example configuration for ARIASKA_RL
# Copy this file to .env and update with your actual values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048

# Environment Configuration
ENVIRONMENT_MODE=simulated  # Options: simulated, live, dynamic
SCENARIO=dynamic
MAX_STEPS_PER_EPISODE=1000

# Training Configuration
TRAINING_EPISODES=100
BATCH_SIZE=64
LEARNING_RATE=0.0001
EPSILON_START=1.0
EPSILON_END=0.01
EPSILON_DECAY=1000

# Agent Configuration
STATE_DIM=128
ACTION_DIM=4
HIDDEN_DIMS=256,256
MEMORY_SIZE=100000

# Logging Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/ariaska.log
VERBOSE=false

# Visualization Configuration
ENABLE_DASHBOARD=true
DASHBOARD_UPDATE_FREQUENCY=10
SAVE_PLOTS=true

# Performance Configuration
CUDA_VISIBLE_DEVICES=0  # Set to empty string to use CPU only
NUM_WORKERS=4
PIN_MEMORY=true

# Security Configuration
SAFE_MODE=true
VALIDATE_INPUTS=true
SANITIZE_OUTPUTS=true

# Checkpoint Configuration
SAVE_FREQUENCY=100
CHECKPOINT_DIR=data/checkpoints
EXPERIMENT_NAME=ariaska_experiment

# Memory Configuration
CHROMA_PERSIST_DIRECTORY=chroma_data
SQLITE_DB_PATH=data/ariaska.db
REPLAY_BUFFER_SIZE=100000

# Network Configuration (for live environments)
TARGET_NETWORK=192.168.1.0/24
SCAN_TIMEOUT=30
MAX_CONCURRENT_SCANS=5

# Advanced Features
ENABLE_DISTRIBUTED_TRAINING=false
WORLD_SIZE=1
RANK=0
MASTER_ADDR=localhost
MASTER_PORT=12355

# Monitoring
ENABLE_TENSORBOARD=true
TENSORBOARD_LOG_DIR=runs
ENABLE_WANDB=false
WANDB_PROJECT=ariaska_rl
WANDB_ENTITY=your_wandb_entity

# Development Settings
DEBUG_MODE=false
PROFILING_ENABLED=false
MEMORY_PROFILING=false
# Configuration for flake8 linting
[flake8]
max-line-length = 88
extend-ignore = 
    E203,  # Whitespace before ':' (conflicts with black)
    W503,  # Line break before binary operator (conflicts with black)
    E501,  # Line too long (handled by black)
    F401,  # Imported but unused (handled by other tools)
max-complexity = 15
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    .eggs,
    *.egg,
    build,
    dist,
    .pytest_cache,
    backup
per-file-ignores =
    __init__.py:F401
    tests/*:S101,S105,S106  # Allow asserts and hardcoded passwords in tests

# Naming conventions
ignore-names = 
    setUp,
    tearDown,
    setUpClass,
    tearDownClass

# Import order
import-order-style = google
application-import-names = core,tests
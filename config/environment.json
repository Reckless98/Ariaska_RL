{
  "default_mode": "simulated",
  "safety_level": "strict",
  "curriculum_stage": 1,
  "domain_randomization": true,
  "ports": [22, 80, 443, 8080, 3306],
  "services": ["ssh", "http", "https", "mysql", "proxy"],
  "os_types": ["linux"],
  "targets": {
    "simulated": {
      "ip": "10.10.10.10",
      "allowed_actions": ["all"]
    },
    "live": {
      "ip": "CTF_TARGET",
      "allowed_actions": ["scan", "enum"]
    }
  },
  "curriculum": {
    "1": {
      "difficulty": "easy",
      "ports": [22, 80, 443],
      "services": ["ssh", "http", "https"],
      "os_types": ["linux"],
      "features": ["basic_auth", "simple_web"]
    },
    "2": {
      "difficulty": "medium",
      "ports": [22, 80, 443, 8080, 3306],
      "services": ["ssh", "http", "https", "mysql", "tomcat"],
      "os_types": ["linux"],
      "features": ["db_access", "web_services", "misconfigurations"]
    },
    "3": {
      "difficulty": "hard",
      "ports": [22, 80, 443, 445, 3306, 8080, 8443],
      "services": ["ssh", "http", "https", "smb", "mysql", "tomcat", "jenkins"],
      "os_types": ["linux", "windows"],
      "features": ["privilege_escalation", "lateral_movement", "complex_exploits"]
    }
  },
  "safety_controls": {
    "strict": {
      "max_threads": 5,
      "delay_between_requests": 1.0,
      "allowed_ips": ["10.0.0.0/8", "192.168.0.0/16", "127.0.0.1"],
      "blocked_commands": ["rm -rf", ":(){ :|:& };:", "dd if=/dev/zero"]
    },
    "standard": {
      "max_threads": 10,
      "delay_between_requests": 0.5,
      "allowed_ips": ["10.0.0.0/8", "192.168.0.0/16", "127.0.0.1"],
      "blocked_commands": ["rm -rf /", ":(){ :|:& };:"]
    },
    "relaxed": {
      "max_threads": 20,
      "delay_between_requests": 0.0,
      "allowed_ips": ["10.0.0.0/8", "192.168.0.0/16", "127.0.0.1"],
      "blocked_commands": ["rm -rf /"]
    }
  }
}